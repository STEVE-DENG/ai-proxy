{
  "name": "ai-proxy",
  "private": true,
  "version": "0.2.0",
  "description": "Local HTTP(S) capture and AI-assisted QA workbench for macOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STEVE-DENG/ai-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/STEVE-DENG/ai-proxy/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "engine:sync": "uv sync --locked --project engine",
    "engine:freeze": "bash scripts/freeze-engine.sh",
    "app:build": "node -e \"import('./scripts/engine-metadata.mjs').then(m => m.verifyEngine())\" && tauri build && node scripts/build-metadata.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "version:set": "node scripts/set-version.mjs",
    "app:install": "node scripts/install-app.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.7",
    "@fontsource-variable/newsreader": "^5.2.7",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
