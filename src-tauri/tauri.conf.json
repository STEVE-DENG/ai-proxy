{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Proxy",
  "version": "0.2.1",
  "identifier": "com.nekoya.ai-proxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 抓包助手",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "本地抓包、AI 分析与接口验证工作台",
    "longDescription": "面向 macOS 的本地 HTTP(S) 抓包工具，支持请求查看、映射改写、弱网模拟、AI 证据分析与接口复现。",
    "externalBin": [
      "binaries/ai-proxy-engine"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
